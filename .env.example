# Caminho para o JSON da conta de serviço Google
GOOGLE_CREDENTIALS_PATH=credentials.json

# ID da planilha Google Sheets (da URL: /spreadsheets/d/ESTE_ID/edit)
SPREADSHEET_ID=

# Token do bot Telegram (obtido via @BotFather)
TELEGRAM_TOKEN=

# Seu Chat ID no Telegram (obtido ao iniciar conversa com o bot e chamando /start)
TELEGRAM_CHAT_ID=

# Pepper para hashing de PINs — string aleatória longa; MUDE antes do primeiro uso.
# ATENÇÃO: alterar este valor invalida todos os PINs existentes (reset necessário).
PIN_PEPPER=

# Chave HMAC para assinar o estado de bloqueio (impede edição direta no Sheets).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=
